# Banco de dados (Neon Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="seu-secret-aqui"

# URL do app (sem barra no final)
NEXTAUTH_URL="http://localhost:3000"

# Login com Google (opcional) — Google Cloud Console > APIs & Services >
# Credentials > Create OAuth client ID > Web application.
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# (e em produção: https://SEU-DOMINIO/api/auth/callback/google)
AUTH_GOOGLE_ID="seu-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="seu-client-secret"
